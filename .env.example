# Copy this file to .env and fill in the values. Node 20.12 or newer loads it automatically.

# Public address of this site. Used in tracking links and the WhatsApp webhook URL.
PUBLIC_URL=http://localhost:3000

# Google Maps: enable "Maps JavaScript API", "Places API (New)" and "Geocoding API".
# This key is visible in the browser, so restrict it to your domain in Google Cloud.
GOOGLE_MAPS_API_KEY=

# WhatsApp Business Cloud API, from Meta for Developers. Keep these secret.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v24.0

# Your own GST registration, shown as the supplier on the consolidated invoice.
UT_GSTIN=
UT_GST_STATE=29

# Shown on the Help page when set.
SUPPORT_PHONE=
SUPPORT_EMAIL=
